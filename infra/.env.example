# Copy to infra/.env (ignored by git) for local development. Never put real secrets in the repository.
POSTGRES_DB=digitaldemocracy
POSTGRES_USER=dd
POSTGRES_PASSWORD=dd-local-only

# api/
API_ADDR=:8080
DATABASE_URL=postgres://dd:dd-local-only@127.0.0.1:5432/digitaldemocracy?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
